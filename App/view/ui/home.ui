/*background principal barra*/
QScrollBar:vertical {
    background: white;
    width: 6px;
    margin: 10px 0 10px 0;
	border-radius: 2px;
 }

/*background barra*/
 QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
	 background: none;
}

/*barra de rolagem*/
 QScrollBar::handle:vertical {
    background: #A8B5E8;
    min-height: 6px;
	border-radius: 2px;
 }

QScrollArea{
	border-radius: 5px;
	border: 1.5px solid #A8B5E8;
}
