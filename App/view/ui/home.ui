   <string notr="true">QLineEdit {
    background-color: #FFFFFF;
    color: #1E1E3A;
    border: 1.8px solid #D6DCF5;
    border-radius: 15px;
    padding: 11px 16px;
    font-size: 14px;
    font-family: 'Segoe UI', 'SF Pro Text', sans-serif;
    selection-background-color: #A8B8FF;
    selection-color: #1E1E3A;
}

QLineEdit:hover {
    border: 1.5px solid #A8B5E8;
    background-color: #FAFBFF;
}

QPushButton {
    background-color: #5B6EE9;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 12px 12px;
    font-size: 13px;
    font-weight: 750;
    font-family: 'Segoe UI', 'SF Pro Text', sans-serif;

}

QPushButton:hover {
    background-color: #4A5DD6;
}

QToolButton {
	background-color: #5B6EE9;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 10px 10px;
    font-size: 13px;
    font-weight: 750;
    font-family: 'Segoe UI', 'SF Pro Text', sans-serif;
}

QToolButton:hover {
    background-color: #4A5DD6;
}

QLabel {
	font-size: 14px;
    font-family: 'Segoe UI', 'SF Pro Text', sans-serif;
	font-weight: 600;
    letter-spacing: 1px;
    padding-left: 4px;
	color: #5B6EE9;
}

/*background principal barra*/
QScrollBar:vertical {
    background: white;
    width: 6px;
    margin: 10px 0 10px 0;
	border-radius: 2px;
 }

/*background barra*/
 QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
	 background: none;
}

/*barra de rolagem*/
 QScrollBar::handle:vertical {
    background: #A8B5E8;
    min-height: 6px;
	border-radius: 2px;
 }

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical{
	height: 0px;
}
 
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical{
	background: transparent;
}

/*background principal barra*/
QScrollBar:horizontal {
    background: white;
    width: 6px;
    margin: 10px 0 10px 0;
	border-radius: 2px;
 }

/*background barra*/
 QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
	 background: none;
}

/*barra de rolagem*/
 QScrollBar::handle:horizontal {
    background: #A8B5E8;
    min-height: 6px;
	border-radius: 2px;
 }

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal{
	height: 0px;
}
 
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal{
	background: transparent;
}

QScrollArea{
	border-radius: 5px;
	border: 1.5px solid #A8B5E8;
}
</string>
